    # "What's the worst that's going to happen?"
    ""

# game/script day12.rpy:20407
translate chinese day12_convincing_arthur_9141d49f:

    # "Attempting to bribe an officer? You shake your head, those nerves feeling a little bit silly. He's the one who'd left you with nothing to lose."
