# game/script day12.rpy:22300
translate chinese day12_arthur_blackmail_with_samuel_e7a7aeb8:

    # a "Unfortunately for her, the naval world is an unyielding one. Steeped in a long and honored tradition, it rarely allows for the bending of its rules—even for someone like her."
    a ""

# game/script day12.rpy:22302
translate chinese day12_arthur_blackmail_with_samuel_0684b8af:

    # a "And so she remains an able seaman for the foreseeable future, since anything more would likely begin to draw too many questions."
    a ""

# game/script day12.rpy:22304
translate chinese day12_arthur_blackmail_with_samuel_d4bf4318:

    # a "All the while some pampered, powdered midshipman gets his promotion to become an officer."
    a ""

# game/script day12.rpy:22306
translate chinese day12_arthur_blackmail_with_samuel_0be9cb2f:

    # a "That is just how it is...{w}And I don't think I have the strength to push against it."
    a ""

# game/script day12.rpy:22308
translate chinese day12_arthur_blackmail_with_samuel_e8575a68:

    # a "Even for her."
    a ""

# game/script day12.rpy:22310
translate chinese day12_arthur_blackmail_with_samuel_58cfeb4b:

    # a "I don't know if I'll ever see her get the recognition she deserves, but one can always hope."
