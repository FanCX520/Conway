    # p "Uhm, well... yes, I do think there's something beautiful about them."
    p ""

# game/script day12.rpy:23384
translate Chinese day12_bioluminescence_arthur_nomax_0b411b8b:

    # p "I've always thought of them as seeds scattered across the night sky, sprouting and glimmering as they bring it to life."
    p ""

# game/script day12.rpy:23386
translate Chinese day12_bioluminescence_arthur_nomax_e5db60fd:

    # p "Only to vanish for their short winter."
    p ""

# game/script day12.rpy:23388
translate Chinese day12_bioluminescence_arthur_nomax_7d642ed0:

    # p "I remember first grasping their vastness when I was a boy—maybe twelve—out in the fields at night."
    p ""

# game/script day12.rpy:23392
translate Chinese day12_bioluminescence_arthur_nomax_d0d8afdb:

    # n "You worked the field at night?"
    n ""

# game/script day12.rpy:23394
translate Chinese day12_bioluminescence_arthur_nomax_66079751:

    # p "Feline eyesight."
    p ""

# game/script day12.rpy:23398
translate Chinese day12_bioluminescence_arthur_nomax_83dffa0c:

    # n "Of course."
    n ""

# game/script day12.rpy:23400
translate Chinese day12_bioluminescence_arthur_nomax_a8b8301a:

    # "You glance at Arthur as you mention your presumed advantage, expecting a lecture or one of his sharp retorts. Instead, he meets your gaze evenly."
    ""

# game/script day12.rpy:23402
translate Chinese day12_bioluminescence_arthur_nomax_92159c13:

    # "You take it as an invitation to continue."
    ""

# game/script day12.rpy:23404
translate Chinese day12_bioluminescence_arthur_nomax_b34285e3:

    # p "In any case, I don't know what stirred it, but one night, it hit me—this overwhelming realization of how immense the sky is. How small I was."
    p ""

# game/script day12.rpy:23406
translate Chinese day12_bioluminescence_arthur_nomax_0eb9aa7d:

    # p "Just a speck, even compared to the field I was lying in. Let alone the sky... or everything else."
    p ""

# game/script day12.rpy:23408
translate Chinese day12_bioluminescence_arthur_nomax_674bfce5:

    # p "I remember lying down with my back on the cool, damp soil, arms flung wide."
    p ""

# game/script day12.rpy:23410
translate Chinese day12_bioluminescence_arthur_nomax_61d4a373:

    # p "Nothing interrupting me. Just... {w}stillness. It was as if I could feel the breath of the night itself."
    p ""

# game/script day12.rpy:23414
translate Chinese day12_bioluminescence_arthur_nomax_da490a20:

    # "A speck..."
    ""

# game/script day12.rpy:23416
translate Chinese day12_bioluminescence_arthur_nomax_95b72521:

    # "Small...{p}Useless...{p}Just as Arthur assumes you to be."
    ""

# game/script day12.rpy:23418
translate Chinese day12_bioluminescence_arthur_nomax_ba0b1dcf:

    # "The horse seems lost in thought for a moment before his lips part again."
    ""

# game/script day12.rpy:23420
translate Chinese day12_bioluminescence_arthur_nomax_00446c14:

    # a "That's quite the poetic thought, lad. I did not take you for being such a philosophical mind.{w} But what I meant was—are you mathematically inclined?"
    a ""

# game/script day12.rpy:23423
translate Chinese day12_bioluminescence_arthur_nomax_667b7e10:

    # a "{cps=5000}That's quite the poetic thought, lad. I did not take you for being such a philosophical mind. But what I meant was—are you mathematically inclined?{/cps}" nointeract
    a "" nointeract

# game/script day12.rpy:23429
translate Chinese day12_bioluminescence_arthur_nomax_6470de7a:

    # p "Well, I don't know if I'd be cut out for navigation, sir. But I did always prefer tasks that engaged the mind rather than the body. Numbers on a page seemed far more manageable than the soil under my hands."
    p ""

# game/script day12.rpy:23431
translate Chinese day12_bioluminescence_arthur_nomax_5feae34d:

    # p "Though I assume keeping the books for a small homestead is leagues away from what is needed to guide a ship with confidence."
    p ""

# game/script day12.rpy:23435
translate Chinese day12_bioluminescence_arthur_nomax_ab022e7b:

    # a "You would be correct in that assumption."
    a ""

# game/script day12.rpy:23437
translate Chinese day12_bioluminescence_arthur_nomax_04d0ed5a:

    # n "Navigation has always seemed like such an elegant science. The idea that one can read the stars and know where they stand in the vastness of the world... It is remarkable."
    n ""

# game/script day12.rpy:23439
translate Chinese day12_bioluminescence_arthur_nomax_1daa123a:

    # n "Polaris is the star used for navigation at night, is it not?"
    n ""

# game/script day12.rpy:23443
translate Chinese day12_bioluminescence_arthur_nomax_edfb8ed9:

    # "Arthur nods, turning his gaze to the sky."
    ""

# game/script day12.rpy:23447
translate Chinese day12_bioluminescence_arthur_nomax_92e6652e:

    # "He scans the stars for a moment before pointing toward a dark patch of clouds, barely visible against the night's backdrop."
    ""

# game/script day12.rpy:23451
translate Chinese day12_bioluminescence_arthur_nomax_92f3284a:

    # a "Quite right. Polaris is the most well-known, but it's hardly the only fixed celestial body we use. There are dozens: Pollux, Antares, or the first star of Aries. In moments like this, when Polaris is hidden, we turn to one of them."
    a ""

# game/script day12.rpy:23453
translate Chinese day12_bioluminescence_arthur_nomax_02bd6a53:

    # a "I will keep it brief to not overwhelm the esteemed gentlemen with too many of the details. We calculate our position east or west using the local hour angle of a celestial body. Then, we use its declination, or latitude, to determine our position north or south."
    a ""

# game/script day12.rpy:23455
translate Chinese day12_bioluminescence_arthur_nomax_b7a3ab6f:

    # a "Of course, these calculations can also be done in reference to the sun, moon, or even planets. And to make the navigator's life easier, we're fortunate to have yearly published Nautical Almanacs and Ephemerides at hand."
    a ""

# game/script day12.rpy:23457
translate Chinese day12_bioluminescence_arthur_nomax_e01b6e68:

    # a "These records detail the expected positions of celestial objects at any given time of the year."
    a ""

# game/script day12.rpy:23459
translate Chinese day12_bioluminescence_arthur_nomax_5315af9a:

    # a "It's a truly ingenious system, refined over centuries by some of the greatest minds the world has ever known."
    a ""

# game/script day12.rpy:23461
translate Chinese day12_bioluminescence_arthur_nomax_00fa5c16:

    # n "It does sound like it."
    n ""

# game/script day12.rpy:23463
translate Chinese day12_bioluminescence_arthur_nomax_df3bb1da:

    # "The painted dog looks more confused now than he did before."
    ""

# game/script day12.rpy:23467
translate Chinese day12_bioluminescence_arthur_nomax_18f44c66:

    # a "And the advancements continue. Just recently, our ship was equipped with a rather fine naval chronometer—despite my own reservations—an innovation that allows for remarkably precise timekeeping, even against the rigors of the open sea."
    a ""

# game/script day12.rpy:23469
translate Chinese day12_bioluminescence_arthur_nomax_1a9f1af7:

    # a "Theoretically, with it, we no longer need to rely so heavily on methods like using the moon to measure time."
    a ""

# game/script day12.rpy:23471
translate Chinese day12_bioluminescence_arthur_nomax_511e3e2b:

    # a "Before this, chronometers were too delicate to endure the constant movement of a ship at sea. Precision is everything in our calculations, and without precise timekeeping, we may find ourselves in France instead."
    a ""

# game/script day12.rpy:23475
translate Chinese day12_bioluminescence_arthur_nomax_d03da14b:

    # a "A most terrible fate, no doubt!"
    a ""

# game/script day12.rpy:23477
translate Chinese day12_bioluminescence_arthur_nomax_ddb0e20d:

    # "Nomax joins Arthur's laugh after a moment, more out of courtesy than anything else."
    ""

# game/script day12.rpy:23481
translate Chinese day12_bioluminescence_arthur_nomax_50382575:

    # n "Quite, sir."
    n ""

# game/script day12.rpy:23488
translate Chinese day12_bioluminescence_arthur_nomax_89811cac:

    # p "Oh, um, well I don't know if I'd be cut out for navigation. I've always been more comfortable with the work I know—hauling crates, fixing fences, that sort of thing."
    p ""

# game/script day12.rpy:23490
translate Chinese day12_bioluminescence_arthur_nomax_36eff5bb:

    # p "Which is probably why I've enjoyed my time as a deckhand as much as I did."
    p ""

# game/script day12.rpy:23492
translate Chinese day12_bioluminescence_arthur_nomax_208d6d16:

    # p "I fear I would make a terrible navigator."
    p ""

# game/script day12.rpy:23494
translate Chinese day12_bioluminescence_arthur_nomax_80799543:

    # a "Very well."
    a ""

# game/script day12.rpy:23498
translate Chinese day12_bioluminescence_arthur_nomax_e5b055aa:

    # "Arthur nods, turning his gaze to the stars."
    ""

# game/script day12.rpy:23500
translate Chinese day12_bioluminescence_arthur_nomax_6def315f:

    # a "Knowing your capabilities is hardly a fault, though I've yet to see much of the physical prowess you speak of, Mr. [family_name]."
    a ""

# game/script day12.rpy:23502
translate Chinese day12_bioluminescence_arthur_nomax_2d3a7270:

    # a "You still look rather uneasy up in the rigging. To the point where I considered keeping you confined to the deck instead."
    a ""

# game/script day12.rpy:23504
translate Chinese day12_bioluminescence_arthur_nomax_771acbd2:

    # n "From what I understand, Mr. [family_name] is new to the ship, yes? In that case, I think his progress is quite admirable."
    n ""

# game/script day12.rpy:23506
translate Chinese day12_bioluminescence_arthur_nomax_c58d588a:

    # n "I do not believe I could manage his work myself."
    n ""

# game/script day12.rpy:23508
translate Chinese day12_bioluminescence_arthur_nomax_4f8c2db5:

    # p "Your trust despite my shortcomings is appreciated, sir."
    p ""

# game/script day12.rpy:23512
translate Chinese day12_bioluminescence_arthur_nomax_c97e32ba:

    # a "{i}Trust{/i} may be a strong word, lad."
    a ""

# game/script day12.rpy:23514
translate Chinese day12_bioluminescence_arthur_nomax_79a43eaf:

    # n "Mr. Hudson, have there been any notable advancements in navigation recently? I can only speak for my own field of study, of course, but there have been quite a few remarkable discoveries of late, and I wondered if the same applied here."
    n ""

# game/script day12.rpy:23518
translate Chinese day12_bioluminescence_arthur_nomax_3e9e9a77:

    # "Though hard to see in the dim light, you catch a faint smile tugging at Arthur's lips."
    ""

# game/script day12.rpy:23520
translate Chinese day12_bioluminescence_arthur_nomax_c763a7ec:

    # "There's pride in that smile, quiet but unmistakable."
    ""

# game/script day12.rpy:23522
translate Chinese day12_bioluminescence_arthur_nomax_2bb7ebb5:

    # a "Indeed, there have been. Our ship, for example, now boasts a state-of-the-art naval chronometer."
    a ""

# game/script day12.rpy:23524
translate Chinese day12_bioluminescence_arthur_nomax_d23e4378:

    # a "Until recently, chronometers couldn't withstand the rigors of a ship at sea. And in navigation, precision is paramount—accurate timekeeping is crucial for calculating our accurate position."
    a ""

# game/script day12.rpy:23526
translate Chinese day12_bioluminescence_arthur_nomax_b97fa1d4:

    # a "It's an expensive device, but even against my expectations it has proven remarkably reliable so far, allowing us to chart our position east or west on Earth with far greater ease than before."
    a ""

# game/script day12.rpy:23530
translate Chinese day12_bioluminescence_arthur_nomax_209b12d6:

    # n "It must be fascinating to work in a field that merges centuries of tradition with the newest innovations."
    n ""

# game/script day12.rpy:23532
translate Chinese day12_bioluminescence_arthur_nomax_dca742d1:

    # n "I can only imagine. It seems that ever-increasing precision is something that permeates every field of study in our time."
    n ""

# game/script day12.rpy:23534
translate Chinese day12_bioluminescence_arthur_nomax_9d079ab4:

    # a "I am certain the Captain would be more than happy to show it to you. It is quite the magnificent device, and I am sure the gentleman would find it fascinating."
    a ""

# game/script day12.rpy:23538
translate Chinese day12_bioluminescence_arthur_nomax_2c3011c5:

    # n "Oh, that would be lovely indeed."
    n ""

# game/script day12.rpy:23540
translate Chinese day12_bioluminescence_arthur_nomax_e2a6f1d6:

    # a "While it has served us well thus far, we still conduct regular calculations to ensure it doesn't err. One should never put blind faith in even the finest instruments, and the old ways done diligently have always gotten us where we needed to be."
    a ""

# game/script day12.rpy:23546
translate Chinese day12_bioluminescence_arthur_nomax_5e65c0b1:

    # "Nomax nods along attentively, clearly captivated by the lesson. His ears tilt slightly forward as he listens."
    ""

# game/script day12.rpy:23548
translate Chinese day12_bioluminescence_arthur_nomax_84130320:

    # n "I will gladly welcome any advancement that makes this voyage safer."
    n ""

# game/script day12.rpy:23552
translate Chinese day12_bioluminescence_arthur_nomax_3450bfa4:

    # a "The gentleman can rest assured—there is nothing to fear. The Captain and crew are most capable, and I would trust them with my life."
    a ""

# game/script day12.rpy:23554
translate Chinese day12_bioluminescence_arthur_nomax_7316fd40:

    # n "I have yet to see anything to make me doubt those words, Mr. Hudson. Still, this gentleman was not born with his sea-legs, and any reassurance is a welcome balm to ease my worries."
    n ""

# game/script day12.rpy:23558
translate Chinese day12_bioluminescence_arthur_nomax_65d51b5e:

    # n "Speaking of advancements... Has there not been some recent experimentation with alternate methods of ship propulsion?"
    n ""

# game/script day12.rpy:23563
translate Chinese day12_bioluminescence_arthur_nomax_4fbf99d1:

    # "The painted dog brings a hand to his chin, rubbing thoughtfully before continuing."
    ""

# game/script day12.rpy:23565
translate Chinese day12_bioluminescence_arthur_nomax_ce40e9b3:

    # n "I believe I faintly recall a broadsheet mentioning some gentleman who presented a boat capable of moving purely through the power of steam."
    n ""

# game/script day12.rpy:23567
translate Chinese day12_bioluminescence_arthur_nomax_75abd40b:

    # n "Somehow..."
    n ""

# game/script day12.rpy:23569
translate Chinese day12_bioluminescence_arthur_nomax_bd61eb8e:

    # n "Unfortunately the name of the good gent escapes me."
    n ""

# game/script day12.rpy:23573
translate Chinese day12_bioluminescence_arthur_nomax_ea4fad16:

    # "Arthur's faint smile fades entirely, replaced by a stern, almost disapproving expression. He turns his head, giving a dismissive wave of his hand."
    ""

# game/script day12.rpy:23577
translate Chinese day12_bioluminescence_arthur_nomax_af32b05f:

    # a "I have heard the stories."
    a ""

# game/script day12.rpy:23579
translate Chinese day12_bioluminescence_arthur_nomax_8b79e921:

    # a "A misplaced effort in my view. All they make is for nice toys, to dazzle dreamers, and separate them from their money."
    a ""

# game/script day12.rpy:23581
translate Chinese day12_bioluminescence_arthur_nomax_54c4fbff:

    # a "They are novelties, nothing more. They're costly, fragile. If one small cog fails, the whole ship is useless."
    a ""

# game/script day12.rpy:23583
translate Chinese day12_bioluminescence_arthur_nomax_3948dd48:

    # a "The wind has dutifully moved ships since time immemorial. And besides, sir—would you sleep comfortably knowing there's a blazing furnace sitting below deck, waiting for a stray spark to ignite it?"
    a ""

# game/script day12.rpy:23585
translate Chinese day12_bioluminescence_arthur_nomax_52d69592:

    # a "Navy ships already have to deal with extensive precautions to minimize the chance of the magazine storage igniting and blowing up the ship. And they do not have to deal with an active fire of the magnitude needed to move a vessel of this size."
    a ""

# game/script day12.rpy:23589
translate Chinese day12_bioluminescence_arthur_nomax_86491876:

    # n "Now, when you put it like that..."
    n ""

# game/script day12.rpy:23591
translate Chinese day12_bioluminescence_arthur_nomax_cb49b8e8:

    # a "No, I think what they {i}should{/i} be working on is a way to allow us to put out more sail, or build hulls that allow us to cut through the water with more ease."
    a ""

# game/script day12.rpy:23595
translate Chinese day12_bioluminescence_arthur_nomax_1a4acf86:

    # n "I can certainly understand the reluctance. It is a world with change coming for us all. More visible for some than for others."
    n ""

# game/script day12.rpy:23597
translate Chinese day12_bioluminescence_arthur_nomax_4612a3c7:

    # n "And for me, well, I am living the change right now."
    n ""

# game/script day12.rpy:23599
translate Chinese day12_bioluminescence_arthur_nomax_d2c40ef8:

    # n "Ships.{w} Not the change I expected."
    n ""

# game/script day12.rpy:23609
translate Chinese day12_bioluminescence_arthur_nomax_f528c9ff:

    # "While the two are caught up in their conversation, you slowly drift toward the edge of the deck."
    ""

# game/script day12.rpy:23611
translate Chinese day12_bioluminescence_arthur_nomax_1da99741:

    # "The gunwale is still damp beneath your palm, the wood cold and rough to the touch. Below, the faint outlines of waves slip by, as the ship glides steadily through the water, and you wait for your moment to hopefully pull one of them aside."
    ""

# game/script day12.rpy:23631
translate Chinese day12_bioluminescence_arthur_abb9e682:

    # n "But if the two gentlemen would excuse me, it is growing rather late, and I believe it is best for me to retreat to my cabin."
    n ""

# game/script day12.rpy:23640
translate Chinese day12_bioluminescence_arthur_d6e7450b:

    # n "I greatly appreciate the time you have taken out of your undoubtedly busy schedule to explain the ship's operation, sir."
    n ""

# game/script day12.rpy:23642
translate Chinese day12_bioluminescence_arthur_d0c60734:

    # n "I will be sure to ask the Captain about the chronometer tomorrow, assuming I can catch him during a quiet hour."
    n ""

# game/script day12.rpy:23649
translate Chinese day12_bioluminescence_arthur_fd06733e:

    # "You watch as the painted dog gives a courteous bow, including you in his goodbyes with a quick, polite nod."
    ""

# game/script day12.rpy:23655
translate Chinese day12_bioluminescence_arthur_bacc1df9:

    # "At least you won't have to risk appearing rude when asking to speak to Arthur."
    ""

# game/script day12.rpy:23666
translate Chinese day12_bioluminescence_arthur_55dd510a:

    # "As Nomax steps away, Arthur shifts, clearly intending to leave as well. You're not sure what compels you to reach out, but your hand catches his arm before you can think better of it."
    ""

# game/script day12.rpy:23668
translate Chinese day12_bioluminescence_arthur_c43bab3b:

    # a "You may return to your duties, recr—"
    a ""

# game/script day12.rpy:23670
translate Chinese day12_bioluminescence_arthur_bf7b8bc1:

    # p "Sir, before I do, may I have a moment to talk?"
    p ""

# game/script day12.rpy:23678
translate Chinese day12_bioluminescence_arthur_49ce9681:

    # "He turns to face you fully and you let go of his cuff, suddenly very aware of your boldness."
    ""

# game/script day12.rpy:23680
translate Chinese day12_bioluminescence_arthur_6e748018:

    # "You know you have to be careful in your position, no matter how much you want an explanation from him."
    ""

# game/script day12.rpy:23682
translate Chinese day12_bioluminescence_arthur_89d97367:

    # "After all, he is still the first mate."
    ""

# game/script day12.rpy:23688
translate Chinese day12_bioluminescence_arthur_274ad1ac:

    # a "We do not need to talk about it."
    a ""

# game/script day12.rpy:23690
translate Chinese day12_bioluminescence_arthur_11bdc346:

    # a "What happened in my cabin. Forget about it. It never happened."
    a ""

# game/script day12.rpy:23692
translate Chinese day12_bioluminescence_arthur_c2362d40:

    # a "You're not the first sailor in history who performed acts like that and you won't be the last—and the less said about my lapse in judgment the better."
    a ""

# game/script day12.rpy:23694
translate Chinese day12_bioluminescence_arthur_3edb87ea:

    # p "No, sir. That's not what I—"
    p ""

# game/script day12.rpy:23696
translate Chinese day12_bioluminescence_arthur_3fd60b34:

    # a "There is nothing to talk about, Mr. [family_name]. Return to your duties."
    a ""

# game/script day12.rpy:23698
translate Chinese day12_bioluminescence_arthur_46d9ef85:

    # p "I just... I wanted to say that I appreciate you allowing me to come along and learn alongside the passenger."
    p ""

# game/script day12.rpy:23702
translate Chinese day12_bioluminescence_arthur_5795200a:

    # p "And it's no surprise you have such a wealth of knowledge, sir."
    p ""

# game/script day12.rpy:23706
translate Chinese day12_bioluminescence_arthur_0b5e09ef:

    # "For a moment, he doesn't respond. Turning to the gunwale, he places both hands on the damp wood, his gaze fixed on the dark expanse of ocean stretching endlessly beyond the ship."
    ""

# game/script day12.rpy:23708
translate Chinese day12_bioluminescence_arthur_26c8c55e:

    # a ". . ."
    a ""

# game/script day12.rpy:23712
translate Chinese day12_bioluminescence_arthur_196f5a03:

    # a "What do you want?"
    a ""

# game/script day12.rpy:23718
translate Chinese day12_bioluminescence_arthur_68883ae6:

    # a "You may join the others during the noon navigation lesson next Friday, if you're interested in furthering your learning."
    a ""

# game/script day12.rpy:23720
translate Chinese day12_bioluminescence_arthur_a74e57a0:

    # a "But I doubt that's the reason you stopped me, is it?"
    a ""

# game/script day12.rpy:23724
translate Chinese day12_bioluminescence_arthur_52a672bd:

    # a "I don't believe this is about furthering your education, recruit."
    a ""

# game/script day12.rpy:23726
translate Chinese day12_bioluminescence_arthur_a811f11f:

    # a "You want to talk about something else."
    a ""

# game/script day12.rpy:23728
translate Chinese day12_bioluminescence_arthur_12cd3a24:

    # p "Well..."
    p ""

# game/script day12.rpy:23730
translate Chinese day12_bioluminescence_arthur_feed9356:

    # "You feel that flicker of tension ripple through you—as familiar as it is unwelcome."
    ""

# game/script day12.rpy:23732
translate Chinese day12_bioluminescence_arthur_5f9c89cb:

    # "The same tension you feel every time you have to face his unyielding demeanor."
    ""

# game/script day12.rpy:23736
translate Chinese day12_bioluminescence_arthur_b251933f:

    # p "To be honest, sir. I don't quite know how to ask."
    p ""

# game/script day12.rpy:23740
translate Chinese day12_bioluminescence_arthur_1360db6e:

    # p "No, sir. I just don't quite know how to ask."
    p ""

# game/script day12.rpy:23744
translate Chinese day12_bioluminescence_arthur_2afb3008:

    # a "That's because there's nothing for you to ask."
    a ""

# game/script day12.rpy:23749
translate Chinese day12_bioluminescence_arthur_6e8cb0fb:

    # a "As far as I'm concerned, the chapter is closed. All you need to know is that you've been allowed to remain aboard this ship."
    a ""

# game/script day12.rpy:23755
translate Chinese day12_bioluminescence_arthur_7895c958:

    # a "I've informed the Captain of my recommendation. He agreed with my assessment and reinstated you into the crew's planning. The quartermaster has been instructed to ensure your continued pay and provisions."
    a ""

# game/script day12.rpy:23757
translate Chinese day12_bioluminescence_arthur_89ab3e0b:

    # a "That should be clear enough for you, or would you disagree?"
    a ""

# game/script day12.rpy:23759
translate Chinese day12_bioluminescence_arthur_13276512:

    # "You open your muzzle, but no sound comes out at first."
    ""

# game/script day12.rpy:23761
translate Chinese day12_bioluminescence_arthur_300701d2:

    # p "I..."
    p ""

# game/script day12.rpy:23766
translate Chinese day12_bioluminescence_arthur_0a18d4c7:

