    # "You swallow the end of your sentence."
    ""

# game/script day12.rpy:28539
translate chinese day12_bioluminescence_sam_julian_080df857:

    # p "I can't be the quiet guy jotting down notes right now."
    p ""

# game/script day12.rpy:28541
translate chinese day12_bioluminescence_sam_julian_394f4f36:

    # "Samuel, still leaning against the mast, tilts [his] head."
    ""

# game/script day12.rpy:28543
translate chinese day12_bioluminescence_sam_julian_748e47c9:

    # p "You... you, of all people, should understand."
    p ""

# game/script day12.rpy:28545
translate chinese day12_bioluminescence_sam_julian_b889dc78:

    # p "Since you..."
    p ""

# game/script day12.rpy:28549
translate chinese day12_bioluminescence_sam_julian_1bfc629e:

    # p "I need to show I belong before thinking about stuff like that."
    p ""

# game/script day12.rpy:28553
translate chinese day12_bioluminescence_sam_julian_546a111e_1:

    # p "That I'm not just here because of-"
    p ""

# game/script day12.rpy:28555
translate chinese day12_bioluminescence_sam_julian_b79346b9:

    # "You swallow the end of your sentence. God, you hope no one ever finds out you got here because of your... {i}skills.{/i}"
    ""

# game/script day12.rpy:28559
translate chinese day12_bioluminescence_sam_julian_bc27edaf:

    # p "That I'm not just here because of someone's pity."
    p ""

# game/script day12.rpy:28561
translate chinese day12_bioluminescence_sam_julian_1f39adb9:

    # p "No, Samuel. I can't be the quiet guy jotting down notes right now."
    p ""

# game/script day12.rpy:28563
translate chinese day12_bioluminescence_sam_julian_394f4f36_1:

    # "Samuel, still leaning against the mast, tilts [his] head."
    ""

# game/script day12.rpy:28567
translate chinese day12_bioluminescence_sam_julian_a393c105:

    # p "You, of all people, should understand me."
    p ""

# game/script day12.rpy:28569
translate chinese day12_bioluminescence_sam_julian_8a3a8e7e:

    # p "And should understand how important it is to actually {i}belong{/i} to the crew."
    p ""

# game/script day12.rpy:28573
translate chinese day12_bioluminescence_sam_julian_2d680b79:

    # p "You should understand me."
