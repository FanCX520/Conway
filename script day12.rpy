# game/script day12.rpy:22268
translate chinese day12_arthur_blackmail_with_samuel_5a6cefa5:

    # a "Cutting your rations?"
    a ""

# game/script day12.rpy:22270
translate chinese day12_arthur_blackmail_with_samuel_5324e824:

    # a "Tying you to the mast?"
    a ""

# game/script day12.rpy:22272
translate chinese day12_arthur_blackmail_with_samuel_bc1bf8e8:

    # a "Flogging?"
