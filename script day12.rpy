translate chinese day12_arthur_blackmail_with_samuel_849840c8:

    # a "You've got guts, lad. I have to give you that."
    a ""

# game/script day12.rpy:22262
translate chinese day12_arthur_blackmail_with_samuel_7d1f7d1f:

    # a "To knock on my door and demand {i}this{/i}. From someone of your rank?{w} There are many a Navy captain who'd envy the balls it took to do that."
