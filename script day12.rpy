    # p "I did accuse you."
    p ""

# game/script day12.rpy:24235
translate Chinese day12_bioluminescence_arthur_b75fe870:

    # a "I'm not talking about today. I'm talking about Samuel's injury, the crane back in port and all those things."
    a ""

# game/script day12.rpy:24237
translate Chinese day12_bioluminescence_arthur_d984232d:

    # a "You did nothing wrong there."
    a ""

# game/script day12.rpy:24241
