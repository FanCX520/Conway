# game/script day12.rpy:15587
translate chinese day12_rajeeyah_letters_ce50f3c5:

    # "The revelation of a name starts to bring everything into focus."
    ""

# game/script day12.rpy:15589
translate chinese day12_rajeeyah_letters_1476089c:

    # p "The person who became your partner. That's Arezki?"
    p ""

# game/script day12.rpy:15591
translate chinese day12_rajeeyah_letters_92b924cc:

    # r "He told me such fascinating stories, that night. How they lived—where they'd come from, how far they traveled across the desert. He told me about Tripoli, and seeing great warships sailing through Gibraltar.{w} Was it true?"
