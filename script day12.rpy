# game/script day12.rpy:15706
translate chinese day12_rajeeyah_letters_69c38439:

    # r "It was a bit of glass he'd brought to me from Tunis, barely worth more than a bronze {i}falus{/i} or two. But for some reason, I told him—firmly as I could: {i}\"Eighty.\"{/i} It didn't take more than a few more words before the merchant came over to see what the fuss was about."
