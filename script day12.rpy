# game/script day12.rpy:31112
translate chinese day12_bioluminescence_sam_julian_ec379207:

    # "At that, [his] smirk returns—softer this time."
    ""

# game/script day12.rpy:31114
translate chinese day12_bioluminescence_sam_julian_090abbd9:

    # s "Arthur stitched me up."
    s ""

# game/script day12.rpy:31116
translate chinese day12_bioluminescence_sam_julian_9e38faa0:

    # s "Kept mutterin' about how he ain't never been trained as a surgeon—only knew how to saw off limbs, not stitch them."
    s ""

# game/script day12.rpy:31118
translate chinese day12_bioluminescence_sam_julian_94c2f440:

    # s "'Course I told him to shut the fuck up and keep going."
    s ""

# game/script day12.rpy:31120
translate chinese day12_bioluminescence_sam_julian_e70a29d3:

    # s "He told me to shut the fuck up or he'd amputate my damn head."
    s ""

# game/script day12.rpy:31124
translate chinese day12_bioluminescence_sam_julian_869543b5:

    # s "Didn't think I'd survive."
    s ""

# game/script day12.rpy:31126
translate chinese day12_bioluminescence_sam_julian_618786c8:

    # s "Arthur was the one to help me when I made it back to the ship."
    s ""

# game/script day12.rpy:31128
translate chinese day12_bioluminescence_sam_julian_dc215c72:

    # s "We were throwing insults at each other until he was done."
    s ""

# game/script day12.rpy:31130
translate chinese day12_bioluminescence_sam_julian_3e96555e:

    # "The memory has [him] tucking [his] head down in a child-like giggle."
