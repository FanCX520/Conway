translate chinese day12_arthur_blackmail_with_samuel_72b6dff0:

    # p "Rough waves. Violent gales. Storms..."
    p ""

# game/script day12.rpy:22204
translate chinese day12_arthur_blackmail_with_samuel_a42073ef:

    # p "It will be fresh in their minds, sir."
