# game/script day12.rpy:15778
translate chinese day12_rajeeyah_letters_8fab7c49:

    # "Instead of the product of hard work and skill, a lifetime's accomplishment, the rules they impose seem to bound an existence just as featureless."
    ""

# game/script day12.rpy:15780
translate chinese day12_rajeeyah_letters_953ef14c:

    # r "He told me that I could be anything. He looked at my hands and said they could be a scribe's hands. Or a surgeon's hands. He said that I was no more bound to one form, one destiny, than the sand dunes were bound to one form, or destiny."
