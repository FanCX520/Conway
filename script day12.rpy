    p ""

# game/script day12.rpy:22182
translate chinese day12_arthur_blackmail_with_samuel_70fca5d5:

    # "You watch his left brow arch slightly upward as he keeps his gaze locked on yours.{w} The urge to break eye contact growing with each passing moment."
