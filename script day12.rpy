    # s "We was killing time with dice, as usual."
    s ""

# game/script day12.rpy:31062
translate chinese day12_bioluminescence_sam_julian_a3c57cf4:

    # s "I'd been drinkin'—a lot.{w} Had a hot streak, coins stacked high like I was king of the table."
