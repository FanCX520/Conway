# game/script day12.rpy:31090
translate chinese day12_bioluminescence_sam_julian_6a7d9cfa:

    # s "Can probably imagine how it went for me."
    s ""

# game/script day12.rpy:31092
translate chinese day12_bioluminescence_sam_julian_386355ae:

    # "[He] drags a thumb over the scar on [his] cheek, tracing its length absently."
    ""

# game/script day12.rpy:31096
translate chinese day12_bioluminescence_sam_julian_18c34d18:

    # s "Bled all over the damn place. Bled all over myself, for fuck's sake.{w} Just me, lyin' there, seeing nothing but red in one eye, starin' at the ceiling, wondering how long it'd take me to die."
    s ""

# game/script day12.rpy:31098
translate chinese day12_bioluminescence_sam_julian_76654e7d:

    # s "Just another nobody, left to rot in the gutters of some foreign port."
    s ""

# game/script day12.rpy:31100
translate chinese day12_bioluminescence_sam_julian_4fe1fd72:

    # s "Got the fucker good, mind.{w} He just got me gooder."
    s ""

# game/script day12.rpy:31102
translate chinese day12_bioluminescence_sam_julian_c223f7e8:

    # "[He] shakes [his] head with a dismissive laugh."
    ""

# game/script day12.rpy:31104
translate chinese day12_bioluminescence_sam_julian_6a969281:

    # s "Nobody came runnin'. Not even death had the courtesy."
    s ""

# game/script day12.rpy:31108
translate chinese day12_bioluminescence_sam_julian_67197178:

