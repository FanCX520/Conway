# game/script day12.rpy:22206
translate chinese day12_arthur_blackmail_with_samuel_04198407:

    # p "And they might look for a reason."
    p ""

# game/script day12.rpy:22208
translate chinese day12_arthur_blackmail_with_samuel_ab3970df:

    # "You can't bring yourself to say it outright—to threaten him with revealing Samuel's secret. Instead, you watch, knowing that Arthur is no fool and is able to put two and two together."
