    # "Framed by the glow of hell itself..."
    ""

# game/script day12.rpy:22224
translate chinese day12_arthur_blackmail_with_samuel_e47855f0:

    # "You feel your chest rise with a deep breath as you wait tensely."
    ""

# game/script day12.rpy:22228
translate chinese day12_arthur_blackmail_with_samuel_60feaec4:

    # "His lips part, the last plume of smoke curling lazily in the thick air."
