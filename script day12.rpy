# game/script day12.rpy:15656
translate chinese day12_rajeeyah_letters_fe66771d:

    # "You shift awkwardly."
    ""

# game/script day12.rpy:15658
translate chinese day12_rajeeyah_letters_245f7b4a:

    # p "I don't know? I've been attracted to people before... er, wanted to spend more time with them..."
