# game/script day12.rpy:15861
translate chinese day12_rajeeyah_letters_56584745:

    # r "Or a peddler of nostrums and cure-alls. Or the inventor of an elixir of youth—you get the idea."
    r ""

# game/script day12.rpy:15863
translate chinese day12_rajeeyah_letters_3087ccce:

    # r "And if I wanted to travel, well... think of how convincing we could be. Two mysterious travelers from North Africa, bearing our ancient texts and wisdom? Any number of European courts would've hosted us, it was true."
    r ""

# game/script day12.rpy:15865
translate chinese day12_rajeeyah_letters_c35d4220:

    # r "I just didn't... I didn't want to {i}be{/i} that. Not anymore."
