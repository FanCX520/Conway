translate chinese day12_arthur_blackmail_with_samuel_18a211d7:

    # "You hate how quiet he is."
    ""

# game/script day12.rpy:22200
translate chinese day12_arthur_blackmail_with_samuel_38e6384a:

    # p "Saying—about, um, women on ships. How they anger the gods of the sea."
