# game/script day12.rpy:22122
translate chinese day12_convincing_arthur_continued_2ce849c8:

    # "Perhaps finally things are starting to tip into your favor."
    ""

# game/script day12.rpy:22133
translate chinese day12_arthur_blackmail_with_samuel_a6c7cc77:

    # "You swallow hard and almost feel it catch in your throat."
    ""

# game/script day12.rpy:22137
translate chinese day12_arthur_blackmail_with_samuel_c1192aa4:

