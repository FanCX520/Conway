# game/script day12.rpy:22246
translate chinese day12_arthur_blackmail_with_samuel_9e41bea5:

    # a "If your demand is to remain aboard this ship in exchange for your silence on the delicate matter concerning {i}Mr. Samuel O'Connor{/i}, then perhaps we may yet be able to find common ground."
