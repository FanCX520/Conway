# game/script day12.rpy:22252
translate chinese day12_arthur_blackmail_with_samuel_147df23b:

    # p "I appreciate that—for once—you understand me, sir."
    p ""

# game/script day12.rpy:22258
translate chinese day12_arthur_blackmail_with_samuel_1a3511eb:

    # "Arthur throws his head back and bellows a laugh, the chair creaking under his weight."
