    # n "Still, I would rather think of it in those terms than return to imagining myself being stowed away in a barren cargo hold."
    n ""

# game/script morocco nomax.rpy:404
translate Chinese day14_nomax_route_start_40ce10fc:

    # p "A Grand Tour?"
    p ""

# game/script morocco nomax.rpy:408
translate Chinese day14_nomax_route_start_950ddd36:

    # n "You have not heard of it?"
    n ""

# game/script morocco nomax.rpy:412
translate Chinese day14_nomax_route_start_c24d2a1a:

    # p "From you, in fact. But you called it {i}unfashionable{/i}, so I did not think you would want to go for it."
    p ""

# game/script morocco nomax.rpy:414
translate Chinese day14_nomax_route_start_0c0dd65e:

    # "Nomax pauses mid-step."
    ""

# game/script morocco nomax.rpy:418
translate Chinese day14_nomax_route_start_31cbb25a:

    # "His fingers begin worrying at the cuff of his sleeve."
    ""

# game/script morocco nomax.rpy:420
translate Chinese day14_nomax_route_start_dfdfb758:

    # n "Ah. Well... yes."
    n ""

# game/script morocco nomax.rpy:422
translate Chinese day14_nomax_route_start_4fd25b94:

    # n "I suppose many people would consider it somewhat passé these days."
    n ""

# game/script morocco nomax.rpy:424
translate Chinese day14_nomax_route_start_db209a12:

    # n "Especially among the sort of gentility who would actually have the opportunity to undertake one."
    n ""

# game/script morocco nomax.rpy:426
translate Chinese day14_nomax_route_start_11f68198:

    # n "I... do hope I do not come across as terribly unfashionable to you."
    n ""

# game/script morocco nomax.rpy:430
translate Chinese day14_nomax_route_start_2b73dece:

    # p "Nomax. You are the one who warned me off it in the first place."
    p ""

# game/script morocco nomax.rpy:434
translate Chinese day14_nomax_route_start_bcd3f23c:

    # "He clears his throat and abruptly becomes fascinated by the cobblestones beneath his paws."
    ""

# game/script morocco nomax.rpy:438
translate Chinese day14_nomax_route_start_e8f83c18:

    # p "Unfashionable or not, it sounded like something a man with your patience would enjoy."
    p ""

# game/script morocco nomax.rpy:442
translate Chinese day14_nomax_route_start_b5dd6fb3:

    # "Your answer seems to please him well enough."
    ""

# game/script morocco nomax.rpy:444
translate Chinese day14_nomax_route_start_8f42eaf3:

    # n "Ah. I suppose I did say that, did I not?"
    n ""

# game/script morocco nomax.rpy:448
translate Chinese day14_nomax_route_start_c2d553c5:

    # n "I simply... wished to make a good impression."
    n ""

# game/script morocco nomax.rpy:450
translate Chinese day14_nomax_route_start_15aca89a:

    # n "I would hate for you to find my tastes, or indeed my company, lacking in excitement merely because some gentleman has decided that a particular manner of traveling has fallen out of favor."
    n ""

# game/script morocco nomax.rpy:452
translate Chinese day14_nomax_route_start_f463bb2e:

    # p "Oh, I do not know..."
    p ""

# game/script morocco nomax.rpy:454
translate Chinese day14_nomax_route_start_b369e760:

    # "You lean in closer, dropping your voice to a playful murmur as you walk beside him."
    ""

# game/script morocco nomax.rpy:456
translate Chinese day14_nomax_route_start_f8bec3bb:

    # p "There is a lot to be said for classic, old-fashioned things. They tend to have much better endurance."
    p ""

# game/script morocco nomax.rpy:460
translate Chinese day14_nomax_route_start_b4d63eeb:

    # p "And they usually know exactly how to handle a long, thorough ride."
    p ""

# game/script morocco nomax.rpy:466
translate Chinese day14_nomax_route_start_d229186a:

    # "Nomax chokes slightly on his own breath, his eyes widening as his ears twitch."
    ""

# game/script morocco nomax.rpy:468
translate Chinese day14_nomax_route_start_122a01b5:

    # n "I—well! That is—"
    n ""

# game/script morocco nomax.rpy:470
translate Chinese day14_nomax_route_start_bcf33087:

    # "He looks everywhere except at you, so wonderfully flustered that you can no longer hide the highly gratified smirk fighting its way across your muzzle."
    ""

# game/script morocco nomax.rpy:472
translate Chinese day14_nomax_route_start_803a7804:

    # p "Do you really think I care about what the general gentility considers fashionable?"
    p ""

# game/script morocco nomax.rpy:480
translate Chinese day14_nomax_route_start_0faa141d:

    # "You slide your hand up, your fingers wrapping in a casual but deeply possessive grip around the small of his back."
    ""

# game/script morocco nomax.rpy:482
translate Chinese day14_nomax_route_start_203a83db:

    # p "I do not give a damn if your clothes are a little old-fashioned. All I care about is how obediently you let me strip them off of you."
    p ""

# game/script morocco nomax.rpy:484
translate Chinese day14_nomax_route_start_40b9e46d:

    # "His ears pin back against his skull, and you see a flicker of helplessness cross his eyes."
    ""

# game/script morocco nomax.rpy:486
translate Chinese day14_nomax_route_start_b33fd217:

    # p "Besides..."
    p ""

# game/script morocco nomax.rpy:488
translate Chinese day14_nomax_route_start_187c8386:

    # p "I love that proper, gentlemanly exterior of yours."
    p ""

# game/script morocco nomax.rpy:490
translate Chinese day14_nomax_route_start_8f0e0c74:

    # p "It just makes it that much more satisfying when I get you behind closed doors and push you down on your knees and quiet that muzzle."
    p ""

# game/script morocco nomax.rpy:494
translate Chinese day14_nomax_route_start_1c92d6c9:

    # n "I... see."
    n ""

# game/script morocco nomax.rpy:496
translate Chinese day14_nomax_route_start_f10d80a5:

    # "It is not difficult to read him, or to see just how much he struggles to think of anything useful to say in return."
    ""

# game/script morocco nomax.rpy:500
translate Chinese day14_nomax_route_start_ba35f3df:

    # n "To be entirely honest, I have not had much experience with riding."
    n ""

# game/script morocco nomax.rpy:502
translate Chinese day14_nomax_route_start_9a695115:

    # p "Riding horses?"
    p ""

# game/script morocco nomax.rpy:506
translate Chinese day14_nomax_route_start_6f6f5c08:

    # n "Of course. What else is—"
    n ""

# game/script morocco nomax.rpy:508
translate Chinese day14_nomax_route_start_ac9e3ee1:

    # "He stops dead in his tracks."
    ""

# game/script morocco nomax.rpy:510
translate Chinese day14_nomax_route_start_0506228d:

    # "Your smirk widens as the tell-tale red begins spreading across his cheeks."
    ""

# game/script morocco nomax.rpy:512
translate Chinese day14_nomax_route_start_48dfa84c:

    # p "Sir, you are not quite as prim and proper as you make yourself out to be, are you?"
    p ""

# game/script morocco nomax.rpy:514
translate Chinese day14_nomax_route_start_18505fdf:

    # p "Another gentleman would not have even entertained the thought."
    p ""

# game/script morocco nomax.rpy:518
translate Chinese day14_nomax_route_start_f7086e79:

    # n "It is not like that! What I—"
    n ""

# game/script morocco nomax.rpy:520
translate Chinese day14_nomax_route_start_78754220:

    # p "Oh, you have told me quite enough already. I can imagine the rest."
    p ""

# game/script morocco nomax.rpy:522
translate Chinese day14_nomax_route_start_41f35ea3:

    # p "On all fours or on your back?"
    p ""

# game/script morocco nomax.rpy:526
translate Chinese day14_nomax_route_start_a029802b:

    # "You do not actually expect him to answer."
    ""

# game/script morocco nomax.rpy:528
translate Chinese day14_nomax_route_start_d89760c8:

    # "And the fact that he somehow gets even redder is all the answer you need."
    ""

# game/script morocco nomax.rpy:530
translate Chinese day14_nomax_route_start_cb8434f8:

    # "You decide to release him from his suffering and graciously change the subject."
    ""

# game/script morocco nomax.rpy:534
translate Chinese day14_nomax_route_start_6194077a:

    # p "So, this {i}Grand Tour{/i} of yours, what exactly is it?"
    p ""

# game/script morocco nomax.rpy:536
translate Chinese day14_nomax_route_start_0605247f:

    # "An exit he is only too happy to take."
    ""

# game/script morocco nomax.rpy:542
translate Chinese day14_nomax_route_start_8aab3735:

    # n "What I merely meant was that, while broader society may view the practice as somewhat antiquated, I did not want {i}you{/i} to think I was dragging you into some dusty, outdated endeavor."
    n ""

# game/script morocco nomax.rpy:546
translate Chinese day14_nomax_route_start_a2f7e943:

    # "He glances at you briefly before his attention drifts to his own paws."
    ""

# game/script morocco nomax.rpy:548
translate Chinese day14_nomax_route_start_95a44541:

    # n "Or worse, that I myself am some sort of dusty, outdated endeavor."
    n ""

# game/script morocco nomax.rpy:550
translate Chinese day14_nomax_route_start_4aa4718c:

    # p "You are definitely not dusty."
    p ""

# game/script morocco nomax.rpy:552
translate Chinese day14_nomax_route_start_b186760e:

    # "You give him a gentle push, offering a warm smile."
    ""

# game/script morocco nomax.rpy:556
translate Chinese day14_nomax_route_start_34c77d97:

    # p "See? No dust."
    p ""

# game/script morocco nomax.rpy:558
translate Chinese day14_nomax_route_start_89d1945a:

    # p "And I really would not care if this were the most outdated endeavor in the world."
    p ""

# game/script morocco nomax.rpy:560
translate Chinese day14_nomax_route_start_a7479a95:

    # p "I am not here to impress the gentility."
    p ""

# game/script morocco nomax.rpy:562
translate Chinese day14_nomax_route_start_521b86f5:

    # p "I am here with you."
    p ""

# game/script morocco nomax.rpy:566
translate Chinese day14_nomax_route_start_297b0208:

    # "A slow, genuine smile breaks through his embarrassment."
    ""

# game/script morocco nomax.rpy:568
translate Chinese day14_nomax_route_start_935657d8:

    # n "That is... highly reassuring to hear."
    n ""

# game/script morocco nomax.rpy:570
translate Chinese day14_nomax_route_start_4d3212a0:

    # n "You do have a remarkable talent for entirely disarming my more foolish anxieties."
    n ""

# game/script morocco nomax.rpy:574
translate Chinese day14_nomax_route_start_a69faf47:

    # "You shake your head as you dodge through the flow of foot traffic."
    ""

# game/script morocco nomax.rpy:576
translate Chinese day14_nomax_route_start_6194077a_1:

    # p "So, this {i}Grand Tour{/i} of yours, what exactly is it?"
    p ""

# game/script morocco nomax.rpy:580
translate Chinese day14_nomax_route_start_02ee13ad:

    # p "Not really. What is it?"
    p ""

# game/script morocco nomax.rpy:584
translate Chinese day14_nomax_route_start_534ca492:

    # "Your answer seems to delight him."
    ""

# game/script morocco nomax.rpy:586
translate Chinese day14_nomax_route_start_7500327c:

    # n "Ah! Well, it is rather an old tradition, although perhaps not quite as fashionable as it once was."
    n ""

# game/script morocco nomax.rpy:588
translate Chinese day14_nomax_route_start_f9205214:

    # n "Though that is hardly the important part. The important part is the idea behind it."
    n ""

# game/script morocco nomax.rpy:590
translate Chinese day14_nomax_route_start_15bb40a5:

    # n "It is a long-standing tradition among finer folk to travel through the great centers of culture, history and learning."
    n ""

# game/script morocco nomax.rpy:592
translate Chinese day14_nomax_route_start_877a7c17:

    # n "Usually in Europe, though I suppose there is no reason the principle itself ought to be restricted."
    n ""

# game/script morocco nomax.rpy:596
translate Chinese day14_nomax_route_start_321fe870:

    # n "One travels, one observes, one studies, and one attempts to broaden one's understanding of the world. Some focus on art. Others on history, architecture, languages, philosophy..."
    n ""

# game/script morocco nomax.rpy:598
translate Chinese day14_nomax_route_start_1facb852:

    # p "And plants, I assume."
    p ""

# game/script morocco nomax.rpy:602
translate Chinese day14_nomax_route_start_81537204:

    # n "Natural sciences, naturally, have become increasingly popular as well."
    n ""

# game/script morocco nomax.rpy:604
translate Chinese day14_nomax_route_start_a1ef4ae1:

    # n "Although, really, there is no strict requirement that one dedicate oneself to a particular field."
    n ""

# game/script morocco nomax.rpy:606
translate Chinese day14_nomax_route_start_fb69a8db:

    # n "The whole point is that you are meant to expose yourself to things you would never encounter at home, and to return with a considerably broader understanding of the world than you had when you left."
    n ""

# game/script morocco nomax.rpy:608
translate Chinese day14_nomax_route_start_e4f8b09e:

    # p "Sounds interesting."
    p ""

# game/script morocco nomax.rpy:610
translate Chinese day14_nomax_route_start_106e3e1f:

    # p "And expensive."
    p ""

# game/script morocco nomax.rpy:614
translate Chinese day14_nomax_route_start_1d9babba:

    # n "No doubt it is!"
    n ""

# game/script morocco nomax.rpy:616
translate Chinese day14_nomax_route_start_96114ea2:

    # "He laughs."
    ""

# game/script morocco nomax.rpy:620
translate Chinese day14_nomax_route_start_c72eb298:

    # n "There are rather a lot of complications involved, when you think about it."
    n ""

# game/script morocco nomax.rpy:622
translate Chinese day14_nomax_route_start_ef5187e7:

    # n "Different currencies, different laws, different customs, and entire principalities and duchies to cross."
    n ""

# game/script morocco nomax.rpy:624
translate Chinese day14_nomax_route_start_73ec51df:

    # n "And, naturally, one needs somewhere to stay, arrangements for traveling, people who can help you navigate unfamiliar places..."
    n ""

# game/script morocco nomax.rpy:626
translate Chinese day14_nomax_route_start_41f536e3:

    # n "A tutor or guide is traditionally rather important as well."
    n ""

# game/script morocco nomax.rpy:628
translate Chinese day14_nomax_route_start_00e33375:

    # n "Someone who knows the language, understands the locality, and can introduce you to the things that one might otherwise overlook."
    n ""

# game/script morocco nomax.rpy:632
translate Chinese day14_nomax_route_start_8a913525:

    # n "Without one, there is always the danger that you spend several weeks traveling through a place without actually understanding anything about it."
    n ""

# game/script morocco nomax.rpy:634
translate Chinese day14_nomax_route_start_71211865:

    # p "You have put quite a lot of thought into this."
    p ""

# game/script morocco nomax.rpy:638
translate Chinese day14_nomax_route_start_a7b97dc9:

    # "Nomax's ears perk almost imperceptibly."
    ""

# game/script morocco nomax.rpy:640
translate Chinese day14_nomax_route_start_228e3b68_1:

    # n "Well..."
    n ""

# game/script morocco nomax.rpy:642
translate Chinese day14_nomax_route_start_7698693c:

    # n "I suppose I have."
    n ""

# game/script morocco nomax.rpy:646
translate Chinese day14_nomax_route_start_433f36a9:

    # n "It is simply that I have always found the idea rather appealing. Not merely the traveling itself, although obviously that is part of it. I mean, the idea that you can leave home and go somewhere you know very little about, and then spend months simply learning things."
    n ""

# game/script morocco nomax.rpy:648
translate Chinese day14_nomax_route_start_2bf31884:

    # n "You see a building you have never seen before, so you find out who built it. You meet somebody whose customs are completely unfamiliar, so you ask why they do things that way."
    n ""

# game/script morocco nomax.rpy:650
translate Chinese day14_nomax_route_start_ba7b3b10:

    # n "You see some strange piece of artwork and suddenly discover that it makes perfect sense once you understand the history behind it."
    n ""

# game/script morocco nomax.rpy:652
translate Chinese day14_nomax_route_start_54237ac7:

    # n "And then, perhaps, you encounter something you have never even thought to look for."
    n ""

# game/script morocco nomax.rpy:654
translate Chinese day14_nomax_route_start_944c306d:

    # p "Such as?"
    p ""

# game/script morocco nomax.rpy:658
translate Chinese day14_nomax_route_start_a390c8bb:

    # n "Oh, almost anything."
    n ""

# game/script morocco nomax.rpy:660
translate Chinese day14_nomax_route_start_e319a726:

    # n "A particular style of architecture. An unusual method of cultivation. A language you have never heard spoken. Some obscure local tradition that nobody at home would ever think twice about."
    n ""

# game/script morocco nomax.rpy:664
translate Chinese day14_nomax_route_start_203919ab:

    # n "Or a plant, naturally, that only grows under conditions you have never encountered before."
    n ""

# game/script morocco nomax.rpy:666
translate Chinese day14_nomax_route_start_0657f333:

    # n "You could spend an entire afternoon looking at one thing and still discover that you have only understood the smallest part of it."
    n ""

# game/script morocco nomax.rpy:668
translate Chinese day14_nomax_route_start_8ef73370:

    # n "That is rather the point, I think. You are not supposed to travel because it is efficient. In fact, it is almost deliberately inefficient. If all you wanted was information, you could stay at home and read a book."
    n ""

# game/script morocco nomax.rpy:670
translate Chinese day14_nomax_route_start_b7dc9147:

    # n "But then you would only know what someone else thought was worth putting into the book."
    n ""

# game/script morocco nomax.rpy:672
translate Chinese day14_nomax_route_start_30d4808b:

    # n "You would not know what the street smells like, or how the light falls across a particular building in the afternoon, or what people actually do when nobody has bothered to describe it to you."
    n ""

# game/script morocco nomax.rpy:674
translate Chinese day14_nomax_route_start_518c88fc:

    # n "You would not know what grows beside the road."
    n ""

# game/script morocco nomax.rpy:676
translate Chinese day14_nomax_route_start_5124003f:

    # p "You really can go on about it."
    p ""

# game/script morocco nomax.rpy:680
translate Chinese day14_nomax_route_start_9f4bc176:

    # n "Hm? Oh, sorry. Was I talking too much?"
    n ""

# game/script morocco nomax.rpy:682
translate Chinese day14_nomax_route_start_70b28f46:

    # "He stops and a sheepish smile slowly creeps across his muzzle."
    ""

# game/script morocco nomax.rpy:684
translate Chinese day14_nomax_route_start_5d075792:

    # p "Not at all. It's fascinating to listen to."
    p ""

# game/script morocco nomax.rpy:686
translate Chinese day14_nomax_route_start_8ce7208e:

    # p "And you even managed to weave mentions of your plants into it."
    p ""

# game/script morocco nomax.rpy:690
translate Chinese day14_nomax_route_start_d9afa13b:

    # n "I did rather manage to bring them into it again."
    n ""

# game/script morocco nomax.rpy:694
translate Chinese day14_nomax_route_start_6a30166f:

    # n "Although, in my defense, plants are rather difficult to exclude from an account of travel when one happens to be journeying somewhere like this."
    n ""

# game/script morocco nomax.rpy:698
translate Chinese day14_nomax_route_start_59988776:

    # n "The climate alone makes it fascinating. I have already noticed several differences from what I am accustomed to seeing, and even familiar species behave differently when the soil, rainfall and temperature change."
    n ""

# game/script morocco nomax.rpy:700
translate Chinese day14_nomax_route_start_311ed3a0:

    # n "There are some adaptations that are so subtle you would miss them entirely unless you knew what to look for, while others are almost absurdly obvious, such as the reduction of leaf surface in particularly dry environments, which of course makes sense because—"
    n ""

# game/script morocco nomax.rpy:704
translate Chinese day14_nomax_route_start_7bb3367c:

    # "He stops himself."
    ""

# game/script morocco nomax.rpy:706
translate Chinese day14_nomax_route_start_3c51e99d:

    # n "...I am doing it again."
    n ""

# game/script morocco nomax.rpy:708
translate Chinese day14_nomax_route_start_2b5f4d50:

    # p "A little."
    p ""

# game/script morocco nomax.rpy:713
translate Chinese day14_nomax_route_start_47e069cb:

    # "He clears his throat and straightens his coat with rather more dignity than the situation requires."
    ""

# game/script morocco nomax.rpy:715
translate Chinese day14_nomax_route_start_152533e4:

    # n "In any event, the broader point is simply that while I am here anyway, I like the idea of seeing the world for myself."
    n ""

# game/script morocco nomax.rpy:717
translate Chinese day14_nomax_route_start_4cd70c60:

    # n "And, if I happen to learn something interesting about the local flora while I am doing so, I can hardly be blamed for that."
    n ""

# game/script morocco nomax.rpy:719
translate Chinese day14_nomax_route_start_f4dc651b:

    # n "Mr. Sterne turned his own Grand Tour into {i}A Sentimental Journey{/i}, after all."
    n ""

# game/script morocco nomax.rpy:723
translate Chinese day14_nomax_route_start_99ec91a7:

    # n "If it was worthwhile enough to occupy his pen, then I see no reason why I should feel as if it is beneath my station."
    n ""

# game/script morocco nomax.rpy:725
translate Chinese day14_nomax_route_start_02e40b43:

    # p "Didn't he die before he finished writing it?"
    p ""

# game/script morocco nomax.rpy:729
translate Chinese day14_nomax_route_start_cd51baf6:

    # n "Yes. Something I assuredly intend to avoid, Mr. [family_name]."
    n ""

# game/script morocco nomax.rpy:731
translate Chinese day14_nomax_route_start_080bb803:

    # p "I should hope so. I would hate to have to finish it for you. There'd be a sudden drop in the quality of plant knowledge and a sudden increase in complaints about the heat to fill the pages."
    p ""

# game/script morocco nomax.rpy:735
translate Chinese day14_nomax_route_start_96a702e0:

    # n "Botanical knowledge, but yes. I shall take that under advisement and endeavor not to inconvenience you."
    n ""

# game/script morocco nomax.rpy:737
translate Chinese day14_nomax_route_start_5fc6fbde:

    # "He beams at that, one paw raised as though he has just delivered a speech."
    ""

# game/script morocco nomax.rpy:739
translate Chinese day14_nomax_route_start_69ee3e6b:

    # "A few heads turn towards you."
    ""

# game/script morocco nomax.rpy:743
translate Chinese day14_nomax_route_start_fd356160:

    # "The moment he notices, his white-tipped tail begins flicking with unmistakable anxiety."
    ""

# game/script morocco nomax.rpy:747
translate Chinese day14_nomax_route_start_7e0c6dcd:

    # n "My apologies. I did not mean to create a scene."
    n ""

# game/script morocco nomax.rpy:749
translate Chinese day14_nomax_route_start_f604fd9c:

    # p "As long as it does not end with us getting mugged because of it—"
    p ""

# game/script morocco nomax.rpy:753
translate Chinese day14_nomax_route_start_7e0ce953:

    # n "Oh dear!"
    n ""

# game/script morocco nomax.rpy:755
translate Chinese day14_nomax_route_start_a8097c2e:

    # p "—I think we will be fine."
    p ""

# game/script morocco nomax.rpy:757
translate Chinese day14_nomax_route_start_7d6a3c99:

    # "You put on your best smile to reassure him and glance around."
    ""

# game/script morocco nomax.rpy:759
translate Chinese day14_nomax_route_start_66acc75e:

    # "Most people have already continued on their way."
    ""

# game/script morocco nomax.rpy:763
translate Chinese day14_nomax_route_start_8a77ba82:

    # n "That sounds like something I would rather avoid. Let us hope such a fate does not befall us."
    n ""

# game/script morocco nomax.rpy:765
translate Chinese day14_nomax_route_start_6803bdb9:

