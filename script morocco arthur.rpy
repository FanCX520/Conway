translate Chinese day14_arthur_start_048df641:

    # "You start to run out of tasks quickly, realizing your limited skillset. "
    ""

# game/script morocco arthur.rpy:233
translate Chinese day14_arthur_start_38a0fa71:

    # p "Pump the bilge?"
    p ""

