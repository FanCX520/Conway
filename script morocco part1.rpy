    p ""

# game/script morocco part1.rpy:5040
translate Chinese day14_continue_morocco_pub_2e82aef3:

    # s "Some of it's just rivalry. We're sailors alike, so, and... rising up through the ranks, as it were."
    s "有部分只是竞争。我们都是水手，所以……就像，我们得在等级中向上爬那样。"

# game/script morocco part1.rpy:5041
translate Chinese day14_continue_morocco_pub_76b90590:

    # s "Some of it's Raj, if I'm honest with you."
    s "老实说，有部分是因为Raj。"

# game/script morocco part1.rpy:5042
translate Chinese day14_continue_morocco_pub_b2372a72:

    # p "Raj?"
    p "Raj？"

# game/script morocco part1.rpy:5046
translate Chinese day14_continue_morocco_pub_d20e2756:

    # s "Perce is one of them sailors who don't like a woman aboard 'less she's the captain's wife or she's in his lap. Half-surprised he didn't try an' throw the surgeon off."
    s "Perce是那种不喜欢女人上船的水手，除非她是船长的妻子或者坐在他腿上。他没试着把外科医生扔下船我都觉得有点意外。"

# game/script morocco part1.rpy:5047
translate Chinese day14_continue_morocco_pub_81bfa06f:

    # p "I'm not sure he could."
    p "我不确定他能不能做到。"

# game/script morocco part1.rpy:5051
translate Chinese day14_continue_morocco_pub_76aef4e7:

    # "Samuel snickers."
    "Samuel窃笑。"

# game/script morocco part1.rpy:5052
translate Chinese day14_continue_morocco_pub_3fc4b54c:

    # s "Skinny fuck like him? Probably not, it's true. But it's the way he talks about her, like. Doesn't really see her as part of the crew."
    s "像他那样瘦骨嶙峋的混蛋？可能不行，这倒是真的。但他谈论她的方式，嗯。他并不真的把她看作是船员的一部分。"

# game/script morocco part1.rpy:5053
translate Chinese day14_continue_morocco_pub_37b066f1:

    # p "Because..."
    p "因为……"

# game/script morocco part1.rpy:5056
