translate Chinese day14_perce_second_favor_reject_7560129f:

    # pb "Not yet."
    pb ""

# game/script morocco part1.rpy:7399
translate Chinese day14_perce_second_favor_reject_d74453ad:

    # pb "Just helping Arthur out as someone he can rely on."
    pb "只是作为Arthur信得过的人帮他一把。"

