    # "[He] says, pointing straight at your snout."
    ""

# game/script morocco part1.rpy:5006
translate Chinese day14_continue_morocco_pub_7c1e8916:

    # p "And I suppose you haven't done that. Is it something in particular you don't like about him?"
    p "我想你没那么做过。是有什么特别让你不喜欢他的地方吗？"

# game/script morocco part1.rpy:5011
translate Chinese day14_continue_morocco_pub_6e5bb95d:

    # p "Trust me, I'm familiar with him. He... offered to help me. A couple days ago."
    p "相信我，我了解他。他……几天前主动提出要帮我。"

# game/script morocco part1.rpy:5012
translate Chinese day14_continue_morocco_pub_810d2da9:

    # s "Help you? Did he, then."
    s "帮你？那么，他帮了吗。"

# game/script morocco part1.rpy:5013
translate Chinese day14_continue_morocco_pub_37354a85:

    # p "I was desperate to stay on the ship. He said he could offer me some alcohol as a bribe. But he wanted, um... payment."
    p "我那时非常想留在船上。他说可以给我一些酒作为贿赂。但他想要，嗯……报酬。"

# game/script morocco part1.rpy:5014
translate Chinese day14_continue_morocco_pub_0073d42b:

    # "Sam rolls [his] eyes, as if it's something that has come up before."
    "Sam翻了翻[他]的眼睛，好像这是以前就发生过的事。"

# game/script morocco part1.rpy:5015
translate Chinese day14_continue_morocco_pub_350ecbf8:

    # s "That sounds about right for him. Your muzzle or your tail?"
    s "这听起来很符合他的作风。报酬是你的哪张嘴？"

# game/script morocco part1.rpy:5016
translate Chinese day14_continue_morocco_pub_44e70043:

    # p "How'd you guess?"
    p "你怎么猜到的？"

# game/script morocco part1.rpy:5017
translate Chinese day14_continue_morocco_pub_e002826e:

    # s "You ask me {i}that{/i}? You ever been in a room with him?"
    s "你问我{i}那个{/i}？你和他在一个房间里待过吗？"

# game/script morocco part1.rpy:5018
translate Chinese day14_continue_morocco_pub_681e3962:

    # "You sigh."
    "你叹了口气"

# game/script morocco part1.rpy:5020
translate Chinese day14_continue_morocco_pub_338f4b02:

    # p "My muzzle. It wasn't {i}bad{/i}, just... I can see how he's not..."
    p "我上面的那张。那倒不{i}坏{/i}，只是……我能明白为什么他不……"

# game/script morocco part1.rpy:5022
translate Chinese day14_continue_morocco_pub_783f90a3:

    # p "My muzzle."
    p "我的嘴巴。"

# game/script morocco part1.rpy:5023
translate Chinese day14_continue_morocco_pub_a6bd302a:

    # p "I can see how he's not..."
    p "我能明白为什么他不是……"

