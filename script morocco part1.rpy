# game/script morocco part1.rpy:7240
translate Chinese day14_perce_second_favor_disagree_7e7ebb83:

    # pb "You're lucky I didn't allow him to sample your ass for being so difficult."
    pb "你该庆幸我没让他尝尝你屁股的滋味，就因为你这么难搞。"

# game/script morocco part1.rpy:7242
translate Chinese day14_perce_second_favor_disagree_e075609f:

    # pb "Really shoulda'..."
