    # p "The fabric, or the dye?"
    p ""

# game/script morocco rajeeyah.rpy:5124
translate Chinese day17_safi_6aece9fe:

    # az "The dye. It comes from snails. Thousands and thousands of snails for a tiny crumb of dye—so it is, you see, very valuable."
