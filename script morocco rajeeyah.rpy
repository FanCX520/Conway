# game/script morocco rajeeyah.rpy:5214
translate Chinese day17_safi_7abc6f10:

    # r "It is your story, Arezki."
    r ""

# game/script morocco rajeeyah.rpy:5216
translate Chinese day17_safi_0edb2e5a:

    # "He stares at her, knowingly, until Rajeeyah relents."
    ""

# game/script morocco rajeeyah.rpy:5218
translate Chinese day17_safi_833beb55:

    # r "Whoever... {i}abandoned{/i}... the clothing did it before making the dye fast."
