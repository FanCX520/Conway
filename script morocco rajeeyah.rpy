    # az "About anything."
    az ""

# game/script morocco rajeeyah.rpy:5198
translate Chinese day17_safi_944c306d:

    # p "Such as?"
    p ""

# game/script morocco rajeeyah.rpy:5202
translate Chinese day17_safi_7a6547fe:

    # az "He gifted a bolt to one of his wives, to use as a shawl. There was a ceremony, to celebrate our transaction, and the hope of much business in the future."
    az ""

# game/script morocco rajeeyah.rpy:5204
