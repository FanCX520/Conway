    # az "Have you known Rajeeyah long?"
    az ""

# game/script morocco rajeeyah.rpy:5674
translate Chinese day17_safi_e94d3e9f:

    # p "Only since I joined her ship."
    p ""

# game/script morocco rajeeyah.rpy:5676
