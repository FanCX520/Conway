    # az "What do you think of her?"
    az ""

# game/script morocco rajeeyah.rpy:5686
translate Chinese day17_safi_f6c26536:

    # az "{cps=5000}What do you think of her?{/cps}" nointeract
    az "" nointeract

# game/script morocco rajeeyah.rpy:5690
translate Chinese day17_safi_4f732e68:

    # p "I've helped her out in the ship's surgery a few times. She is quite brilliant, I think."
    p ""

# game/script morocco rajeeyah.rpy:5692
translate Chinese day17_safi_6e3e99cc:

    # az "Oh, that has always been so, yes!"
    az ""

# game/script morocco rajeeyah.rpy:5694
translate Chinese day17_safi_bdfe0658:

    # p "And she has created a place for herself on a sailing ship, even as an outsider."
    p ""

# game/script morocco rajeeyah.rpy:5698
translate Chinese day17_safi_f7e30064:

    # az "That has also often been her fate."
    az ""

# game/script morocco rajeeyah.rpy:5700
translate Chinese day17_safi_bb2bc194:

    # p "And sailors can be skeptical. But they've accepted her."
    p ""

# game/script morocco rajeeyah.rpy:5704
translate Chinese day17_safi_df5e19b8:

    # az "Is she happy?"
    az ""

# game/script morocco rajeeyah.rpy:5706
translate Chinese day17_safi_ba9d05fd:

    # "In truth, do you even know her well enough to answer that question? Perhaps, at this point, you do."
    ""

# game/script morocco rajeeyah.rpy:5708
