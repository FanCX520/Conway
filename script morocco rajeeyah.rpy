# game/script morocco rajeeyah.rpy:5238
translate Chinese day17_safi_73ae705d:

    # r "No."
    r ""

# game/script morocco rajeeyah.rpy:5248
translate Chinese day17_safi_e62693c2:

    # az "Some common indigo, mixed with something else."
    az ""

# game/script morocco rajeeyah.rpy:5258
translate Chinese day17_safi_d9ff82ac:

    # "Rajeeyah's expression is, gradually, changing—jaw tensing as she attempts to hold her fixed, impassive look."
