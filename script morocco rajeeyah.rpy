    # "He begins recounting it with an expansive wave of his paw."
    ""

# game/script morocco rajeeyah.rpy:5116
translate Chinese day17_safi_c95c1168:

    # az "I had come upon a wagon of linen goods, you see, and it was very fine indeed."
    az ""

# game/script morocco rajeeyah.rpy:5118
translate Chinese day17_safi_c9136004:

    # az "They were blue. Some of them were embroidered, some merely dyed. On the coast, they are known for it. In Mogador, especially."
