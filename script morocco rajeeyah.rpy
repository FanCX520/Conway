# game/script morocco rajeeyah.rpy:5612
translate Chinese day17_safi_8412d499:

    # p "Yes. Different constellations."
    p ""

# game/script morocco rajeeyah.rpy:5614
translate Chinese day17_safi_3d0090dd:

    # az "Everything is new to you. If you sleep, you might miss it."
    az ""

# game/script morocco rajeeyah.rpy:5616
translate Chinese day17_safi_3b88c420_2:

    # p "Yes."
    p ""

# game/script morocco rajeeyah.rpy:5618
translate Chinese day17_safi_eecbce1c:

    # az "This, I know."
    az ""

# game/script morocco rajeeyah.rpy:5620
