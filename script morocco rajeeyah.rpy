# game/script morocco rajeeyah.rpy:5260
translate Chinese day17_safi_bec3b4af_1:

    # r "Yes."
    r ""

# game/script morocco rajeeyah.rpy:5270
translate Chinese day17_safi_ce322d7c:

    # az "It {i}ran{/i}."
    az ""

# game/script morocco rajeeyah.rpy:5280
translate Chinese day17_safi_b37f9e43:

    # r "She did not notice. She was ordering the servants around, yelling at them, and all the while we were staring at her..."
    r ""

# game/script morocco rajeeyah.rpy:5290
translate Chinese day17_safi_c0b51690:

    # az "Until her husband asked: 'what has happened to you, Saliha?'"
    az ""

# game/script morocco rajeeyah.rpy:5300
translate Chinese day17_safi_b39804e8:

    # "Rajeeyah twitches, and corrects him."
    ""

# game/script morocco rajeeyah.rpy:5302
translate Chinese day17_safi_c5073783:

    # r "That is not what he said, Arezki."
    r ""

# game/script morocco rajeeyah.rpy:5312
translate Chinese day17_safi_c4b9310a:

    # az "Well, he said—"
    az ""

# game/script morocco rajeeyah.rpy:5322
translate Chinese day17_safi_84d64e66:

    # r "He said: 'Saliha...'"
    r ""

# game/script morocco rajeeyah.rpy:5326
translate Chinese day17_safi_c76a743e:

    # "She trails off, tries to catch herself, and loses her composure."
    ""

# game/script morocco rajeeyah.rpy:5330
translate Chinese day17_safi_e91cfd8e:

    # r "'Saliha, you look like a grape!' And you laughed!"
    r ""

# game/script morocco rajeeyah.rpy:5334
translate Chinese day17_safi_d6f110a6:

    # az "You're laughing now!"
    az ""

# game/script morocco rajeeyah.rpy:5336
translate Chinese day17_safi_49a012aa:

    # r "I am not at a formal dinner!"
    r ""

# game/script morocco rajeeyah.rpy:5338
translate Chinese day17_safi_5ff0decd:

    # "Rajeeyah takes the piece of cloth, and rubs it carefully between her fingers. Nothing seems to have come off."
