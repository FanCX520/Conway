# game/script morocco samuel.rpy:837
translate Chinese day15_samuel_raj_bathhouse_intro_a563a8e9:

    # "She leans back, her tail curling and uncurling languidly. Her chest rises and falls with deep breaths that you try to emulate. {i}Is{/i} the hot steam filling your lungs good for you?"
