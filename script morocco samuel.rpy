    # r "I told you about what he did."
    r ""

# game/script morocco samuel.rpy:2959
translate chinese day15_sam_hotel_intro_ff4dfd05:

    # "There's a brief pause in their conversation before Rajeeyah speaks up again."
    ""

# game/script morocco samuel.rpy:2961
