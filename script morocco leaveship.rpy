# game/script morocco leaveship.rpy:3
translate Chinese day14_leave_ending_solo_efb09912:

    # "Your stomach twists itself into a knot."
    ""

# game/script morocco leaveship.rpy:5
translate Chinese day14_leave_ending_solo_54573f7d:

    # "The moment you leave the ship, the world turns into an indistinct haze. Thick and suffocating enough that you are threatened to lose yourself in it."
    ""

# game/script morocco leaveship.rpy:7
translate Chinese day14_leave_ending_solo_226d890f:

    # "And now..."
    ""

# game/script morocco leaveship.rpy:15
translate Chinese day14_leave_ending_solo_cb1fa1ab:

    # "Now, the dock is firm beneath you."
    ""

# game/script morocco leaveship.rpy:17
translate Chinese day14_leave_ending_solo_4e513a06:

    # "You almost stumble over your own paws as they still seek to account for the sway of the ship."
    ""

# game/script morocco leaveship.rpy:19
translate Chinese day14_leave_ending_solo_abc15927:

    # "Would it matter if you fell? You've already fallen from everything that mattered. What's one more humiliation?"
    ""

# game/script morocco leaveship.rpy:21
translate Chinese day14_leave_ending_solo_bb230f67:

    # "You're alone anyway."
    ""

# game/script morocco leaveship.rpy:23
translate Chinese day14_leave_ending_solo_fef4ed6d:

    # "All the things that would have made this moment of stepping out onto foreign soil special, now just a reminder for what you've lost."
    ""

# game/script morocco leaveship.rpy:25
translate Chinese day14_leave_ending_solo_fea90245:

    # "The harbor air is warm, no, quite hot actually as the breeze tugs at your fur."
    ""

# game/script morocco leaveship.rpy:27
translate Chinese day14_leave_ending_solo_bdbe5f14:

    # "Gently most of the time, though with gusts that send strands of it dangerously close to your eyes."
    ""

# game/script morocco leaveship.rpy:29
translate Chinese day14_leave_ending_solo_c5708286:

    # "The endless blue sky above, sheltering Mogador beneath it. A town so far away from where you lived that it's hard to even imagine the distance that lies between you and home."
    ""

# game/script morocco leaveship.rpy:31
translate Chinese day14_leave_ending_solo_09cdea96:

    # "What might your parents be doing right now?"
    ""

# game/script morocco leaveship.rpy:33
translate Chinese day14_leave_ending_solo_d3d1421c:

    # "Worrying?"
    ""

# game/script morocco leaveship.rpy:35
translate Chinese day14_leave_ending_solo_cddb1846:

    # "They did when you left, and it appears that their worries weren't unfounded..."
    ""

# game/script morocco leaveship.rpy:37
translate Chinese day14_leave_ending_solo_54eed24f:

    # "If only you'd have listened."
    ""

# game/script morocco leaveship.rpy:39
translate Chinese day14_leave_ending_solo_9804a638:

    # "This strange, sun-bleached town of white walls and colors so sharp they ache. Cerulean shutters, crimson balconies. Gold and green and red, all of it too much after weeks of nothing but timber and tar."
    ""

# game/script morocco leaveship.rpy:41
translate Chinese day14_leave_ending_solo_73b9027c:

    # "You can't look away from the {i}Conway{/i}."
    ""

# game/script morocco leaveship.rpy:43
translate Chinese day14_leave_ending_solo_0cb4820a:

    # "Not yet."
    ""

# game/script morocco leaveship.rpy:45
translate Chinese day14_leave_ending_solo_1093a7b7:

    # "This ship that you've grown quite fond of.{w} Despite everything."
    ""

# game/script morocco leaveship.rpy:47
translate Chinese day14_leave_ending_solo_878a6640:

    # "Even despite Arthur..."
    ""

# game/script morocco leaveship.rpy:49
translate Chinese day14_leave_ending_solo_0369cb16:

    # "You search the deck for him. {w}Just once.{w} Just to see if he'd look back."
    ""

# game/script morocco leaveship.rpy:51
translate Chinese day14_leave_ending_solo_8fa0200f:

    # "But there's no sign of him."
    ""

# game/script morocco leaveship.rpy:53
translate Chinese day14_leave_ending_solo_08ec8039:

    # "Of course not."
    ""

# game/script morocco leaveship.rpy:55
translate Chinese day14_leave_ending_solo_b62700bc:

    # "He's probably below, {i}\"dealing with paperwork more important than the runt of the litter left behind.\"{/i}"
    ""

# game/script morocco leaveship.rpy:57
translate Chinese day14_leave_ending_solo_65e475a2:

    # "Time stretches. For all you know you could have been standing there for minutes. Hours. Desperately wanting for time to stand still, and for you to always be able to cling to the view back at the {i}Conway{/i}."
    ""

# game/script morocco leaveship.rpy:59
translate Chinese day14_leave_ending_solo_7fe9e8f6:

    # "But... it cannot last."
    ""

# game/script morocco leaveship.rpy:61
translate Chinese day14_leave_ending_solo_e0972e9f:

    # "Lifting your paw is a monumental effort. It takes everything you have.{w} One step. Then another."
    ""

# game/script morocco leaveship.rpy:66
translate Chinese day14_leave_ending_solo_1c849a66:

    # "You meander along the harborfront so slowly that its workers flow around you like water does around a rock. They all have places to be."
    ""

# game/script morocco leaveship.rpy:68
translate Chinese day14_leave_ending_solo_a327978e:

    # "Mogador."
    ""

# game/script morocco leaveship.rpy:70
translate Chinese day14_leave_ending_solo_3afc5c43:

    # "Your brow furrows as you take stock of your surroundings."
    ""

# game/script morocco leaveship.rpy:72
translate Chinese day14_leave_ending_solo_66dd7b19:

    # "It looks... curious."
    ""

# game/script morocco leaveship.rpy:74
translate Chinese day14_leave_ending_solo_b798f8c7:

    # "Beauty you might be able to appreciate more under different circumstances."
    ""

# game/script morocco leaveship.rpy:76
translate Chinese day14_leave_ending_solo_4e3fe270:

    # "A hollow ache settles in at the realization of a moment of awe lost to you."
    ""

# game/script morocco leaveship.rpy:78
translate Chinese day14_leave_ending_solo_9f3d2ab9:

    # "Where do you even start?"
    ""

# game/script morocco leaveship.rpy:80
translate Chinese day14_leave_ending_solo_8b8a7d69:

    # "Look for another ship?"
    ""

# game/script morocco leaveship.rpy:82
translate Chinese day14_leave_ending_solo_f7e3c6b4:

    # "Your eyes find the {i}Conway{/i} again, widening slightly before closing."
    ""

# game/script morocco leaveship.rpy:84
translate Chinese day14_leave_ending_solo_440aaec7:

    # "You don't have it in you. Not right now."
    ""

# game/script morocco leaveship.rpy:90
translate Chinese day14_leave_ending_solo_847e0d3e:

    # "For now you just want to get away from the sights and sounds of the harbor. One of the alleyways provides the desired escape and leads between two rows of multi-story houses."
    ""

# game/script morocco leaveship.rpy:92
translate Chinese day14_leave_ending_solo_944dd5bc:

    # "A rush of cool air embraces you as soon as you step out of the sun, with a slight breeze getting chased through this narrow alleyway."
    ""

# game/script morocco leaveship.rpy:94
translate Chinese day14_leave_ending_solo_787a4120:

    # "Almost claustrophobic at first, you quickly begin to appreciate just how much it muffles your surroundings. Few people, the sounds from the harbor dulled to an indistinct hum by the thick brick walls."
    ""

# game/script morocco leaveship.rpy:96
translate Chinese day14_leave_ending_solo_312961a6:

    # "What remains are the sounds of the seagulls as they pass overhead, and the occasional rattle of one of the shutters whenever the wind tugs on it."
    ""

# game/script morocco leaveship.rpy:98
translate Chinese day14_leave_ending_solo_33b5372f:

    # "For a moment it's... peaceful."
    ""

# game/script morocco leaveship.rpy:104
translate Chinese day14_leave_ending_solo_9e126014:

    # "Though inevitably the narrow alley ends into a broader thoroughfare, with merchants lining it along both sides. Some have stalls set up, others have merely a few items they set up on a simple carpet on the ground."
    ""

# game/script morocco leaveship.rpy:106
translate Chinese day14_leave_ending_solo_95a86dde:

    # "It doesn't take long before you are swept into the flow of this arterial road of the town."
    ""

# game/script morocco leaveship.rpy:108
translate Chinese day14_leave_ending_solo_1364e251:

    # "An older deer lady offers you something—food, maybe?"
    ""

# game/script morocco leaveship.rpy:110
translate Chinese day14_leave_ending_solo_5848201a:

    # "You don't understand a word."
    ""

# game/script morocco leaveship.rpy:112
translate Chinese day14_leave_ending_solo_a2a1ba66:

    # "Neither do you really look at it."
    ""

# game/script morocco leaveship.rpy:120
translate Chinese day14_leave_ending_solo_dbb17d27:

    # "She gives up when you remain unresponsive."
    ""

# game/script morocco leaveship.rpy:127
translate Chinese day14_leave_ending_solo_b9df387e:

    # "Eventually the road passes a plaza with a large tree spanning across from one side to the other, blanketing the whole area in its shade."
    ""

# game/script morocco leaveship.rpy:129
translate Chinese day14_leave_ending_solo_4ee634a7:

    # "What the tree doesn't cover, is instead covered by colorful mix of cloth and wooden shades attached to the surrounding buildings."
    ""

# game/script morocco leaveship.rpy:131
translate Chinese day14_leave_ending_solo_43e16f6b:

    # "You sink onto the low stone wall that surrounds the criss-crossing roots of the tree, your belongings thudding next to your paws."
    ""

# game/script morocco leaveship.rpy:133
translate Chinese day14_leave_ending_solo_e2b0a4eb:

    # "You take a view across the plaza. Draped in a blanket of gently moving dappled light being cast down from the tree."
    ""

# game/script morocco leaveship.rpy:135
translate Chinese day14_leave_ending_solo_d501f377:

    # "It seems unfair that the world remains beautiful when you are unable to appreciate it."
    ""

# game/script morocco leaveship.rpy:137
translate Chinese day14_leave_ending_solo_af3f83ba:

    # "This is your new \"home.\""
    ""

# game/script morocco leaveship.rpy:139
translate Chinese day14_leave_ending_solo_9f14a469:

    # "One that is alive—alive with voices, gesturing, laughter, arguments, the rustle of fabric, the scent of spices."
    ""

# game/script morocco leaveship.rpy:141
translate Chinese day14_leave_ending_solo_226a1790:

    # "Yet all of it feels foreign."
    ""

# game/script morocco leaveship.rpy:143
translate Chinese day14_leave_ending_solo_c0681a37:

    # "A home where you don't understand a word that's being spoken around you."
    ""

# game/script morocco leaveship.rpy:145
translate Chinese day14_leave_ending_solo_e74c5431:

    # "Without Samuel to patiently show you the ropes. Without Wolf gruffly telling you to get lost. None of Bandile's food, or the stories of Konrad and Julian."
    ""

# game/script morocco leaveship.rpy:147
translate Chinese day14_leave_ending_solo_6f151b45:

    # "Stupid and unbelievable as they may have been."
    ""

# game/script morocco leaveship.rpy:149
translate Chinese day14_leave_ending_solo_29191d61:

    # "Two weeks on a ship, and they already feel like lifelong friends."
    ""

# game/script morocco leaveship.rpy:151
translate Chinese day14_leave_ending_solo_fcb8cfc9:

    # "Now it's gone."
    ""

# game/script morocco leaveship.rpy:153
translate Chinese day14_leave_ending_solo_f42bae5b:

    # "Those that you believed friends have left you to fend for your own..."
    ""

# game/script morocco leaveship.rpy:155
translate Chinese day14_leave_ending_solo_61de6be5:

    # "Now you're here, in a place that isn't home, with people who you feel aren't yours."
    ""

# game/script morocco leaveship.rpy:159
translate Chinese day14_leave_ending_solo_dda6b142:

    # "It's impossible not to think back and try to find the moment where it all collapsed."
    ""

# game/script morocco leaveship.rpy:161
translate Chinese day14_leave_ending_solo_acc2d149:

    # "To find that one moment where, if only you had acted differently, perhaps things would have gone differently?"
    ""

# game/script morocco leaveship.rpy:165
translate Chinese day14_leave_ending_solo_81da2e08:

    # "Not antagonizing Arthur probably would have been a good start. You think yourself a damn idiot."
    ""

# game/script morocco leaveship.rpy:167
translate Chinese day14_leave_ending_solo_201f6f00:

    # "Out of everyone you had to go and mess up with the first mate of the ship."
    ""

# game/script morocco leaveship.rpy:171
translate Chinese day14_leave_ending_solo_7bfdbdf7:

    # "You should have known better. Perhaps should have tried to inform yourself about the strict hierarchy on the ship before asking to dine with him..."
    ""

# game/script morocco leaveship.rpy:175
translate Chinese day14_leave_ending_solo_168eb4f0:

    # "If nothing else, at least you could have avoided making it worse right the next day..."
    ""

# game/script morocco leaveship.rpy:179
translate Chinese day14_leave_ending_solo_0816527f:

    # "If only you hadn't raised your voice that day... It no doubt made his suspicion even worse."
    ""

# game/script morocco leaveship.rpy:181
translate Chinese day14_leave_ending_solo_10a18c62:

    # "Perhaps the lesson is to just shut up? You don't know."
    ""

# game/script morocco leaveship.rpy:185
translate Chinese day14_leave_ending_solo_24386aa1:

    # "Perhaps not bedding on the ship at the first possible opportunity, or if you do at least be discrete about it."
    ""

# game/script morocco leaveship.rpy:187
translate Chinese day14_leave_ending_solo_4cc7e800:

    # "If only Nomax would have kept his muzzle shut..."
    ""

# game/script morocco leaveship.rpy:191
translate Chinese day14_leave_ending_solo_df07ec9c:

    # "Not antagonizing the ship's surgeon and close friend of Arthur probably would have been a good start."
    ""

# game/script morocco leaveship.rpy:193
translate Chinese day14_leave_ending_solo_feef1aa3:

    # "You think back to that evening with Rajeeyah and how much of a fool you made yourself to be. The memory makes you want to sink into the ground right here and now. Never to be seen again."
    ""

# game/script morocco leaveship.rpy:195
translate Chinese day14_leave_ending_solo_3826c523:

    # "The sweet release of oblivion would probably be the easier solution that whatever is ahead of you."
    ""

# game/script morocco leaveship.rpy:199
translate Chinese day14_leave_ending_solo_137fced4:

    # "Maybe it all fell apart with Wolf? Perhaps if you two had gotten along better then none of this would have happened."
    ""

# game/script morocco leaveship.rpy:201
translate Chinese day14_leave_ending_solo_0977f35e:

    # "You could still be part of that group of new landsmen."
    ""

# game/script morocco leaveship.rpy:203
translate Chinese day14_leave_ending_solo_a67608b6:

    # "Or perhaps you are just unduly beating yourself up... What would it really have changed if you'd left him alone?"
    ""

# game/script morocco leaveship.rpy:205
translate Chinese day14_leave_ending_solo_60e44ca4:

    # "But you're sure fault doesn't just lie with yourself."
    ""

# game/script morocco leaveship.rpy:207
translate Chinese day14_leave_ending_solo_fc20c165:

    # "No, you're sure it doesn't."
    ""

# game/script morocco leaveship.rpy:209
translate Chinese day14_leave_ending_solo_5622c4fb:

    # "You curse Arthur, and everything he has done, the fact that he singled you out and caused this whole mess. Not just him, but those he holds dear as well."
    ""

# game/script morocco leaveship.rpy:211
translate Chinese day14_leave_ending_solo_b6c2d1d2:

    # "It feels good. Though even better would be getting to say it to his face."
    ""

# game/script morocco leaveship.rpy:217
translate Chinese day14_leave_ending_solo_b4140ab7:

    # "You press your face into your paws. Letting the messy stream of thoughts wreak havoc on your mind until you feel ready to bear the sight of the world again."
    ""

# game/script morocco leaveship.rpy:222
translate Chinese day14_leave_ending_solo_cf4a39c1:

    # "Your fur comes away damp."
    ""

# game/script morocco leaveship.rpy:224
translate Chinese day14_leave_ending_solo_a399e0dd:

    # "Around you, the world keeps moving."
    ""

# game/script morocco leaveship.rpy:226
translate Chinese day14_leave_ending_solo_12a3a185:

    # "You hadn't meant to cry."
    ""

# game/script morocco leaveship.rpy:228
translate Chinese day14_leave_ending_solo_2cd2afd9:

    # "You don't even know when it started."
    ""

# game/script morocco leaveship.rpy:230
translate Chinese day14_leave_ending_solo_31607f12:

    # "Somewhere in that litany of memories about them, you suppose."
    ""

# game/script morocco leaveship.rpy:235
translate Chinese day14_leave_ending_solo_fe2ff17a:

    # "Samuel. Wolf. Bandile. Konrad. Julian."
    ""

# game/script morocco leaveship.rpy:237
translate Chinese day14_leave_ending_solo_5c2f0b18:

    # "All of them on that ship right now. Going about their lives."
    ""

# game/script morocco leaveship.rpy:239
translate Chinese day14_leave_ending_solo_06ecdab9:

    # "Already not thinking of you anymore."
    ""

# game/script morocco leaveship.rpy:246
translate Chinese day14_leave_ending_solo_f6695a4a:

    # "Nor does anyone pay notice to the lonely, foreign looking cat."
    ""

# game/script morocco leaveship.rpy:248
translate Chinese day14_leave_ending_solo_12e87367:

    # "Why would they?"
    ""

# game/script morocco leaveship.rpy:250
translate Chinese day14_leave_ending_solo_3b4158ac:

    # "There is nothing remarkable about grief."
    ""

# game/script morocco leaveship.rpy:252
translate Chinese day14_leave_ending_solo_22c105af:

    # "The tree you are sitting under has seen its share of it, surely. Long before you arrived and will long after you've gone."
    ""

# game/script morocco leaveship.rpy:254
translate Chinese day14_leave_ending_solo_539e084f:

    # "The branches above shift in the wind."
    ""

# game/script morocco leaveship.rpy:256
translate Chinese day14_leave_ending_solo_464fc767:

    # "A single leaf lets go and tumbles down, landing somewhere in the dirt beside your paw."
    ""

# game/script morocco leaveship.rpy:258
translate Chinese day14_leave_ending_solo_590e0c42:

    # "You watch it for a long moment."
    ""

# game/script morocco leaveship.rpy:268
translate Chinese day14_leave_ending_solo_6c1e53e3:

    # "Beneath you, dark spots begin to bloom in the dry earth."
    ""

# game/script morocco leaveship.rpy:299
translate Chinese day14_leave_ending_julian_6504f6d9:

    # "You sit in the shadow of the imposing town gate, slumped against its stone and shielded from the blistering sun."
    ""

# game/script morocco leaveship.rpy:301
translate Chinese day14_leave_ending_julian_fd93e244:

    # "It is a scalding day—the sort that, back home, you might experience only a handful of times each summer."
    ""

# game/script morocco leaveship.rpy:303
translate Chinese day14_leave_ending_julian_92afda7a:

    # "Even in the shade, the only saving grace is the cooling breeze drifting in from the sea."
    ""

# game/script morocco leaveship.rpy:305
translate Chinese day14_leave_ending_julian_a3d2c887:

    # p "Should be almost dinner time, surely..."
    p ""

# game/script morocco leaveship.rpy:307
translate Chinese day14_leave_ending_julian_49429578:

    # "You mutter to yourself, scanning the road for that familiar green lizard."
    ""

# game/script morocco leaveship.rpy:309
translate Chinese day14_leave_ending_julian_1d8e654b:

    # "Not that he'll be hard to spot. He's bound to look like a fish out of water among the way the locals dress around here."
    ""

# game/script morocco leaveship.rpy:311
translate Chinese day14_leave_ending_julian_9bfb4cd1:

    # "Those light, airy-looking clothes make a lot of sense, all things considered. Might be one of the first things on the list to get for yourselves."
    ""

# game/script morocco leaveship.rpy:316
translate Chinese day14_leave_ending_julian_14f560ac:

    # "Well. Right after you get your paws on some coin."
    ""

# game/script morocco leaveship.rpy:318
translate Chinese day14_leave_ending_julian_64b21c15:

    # "Where is he?"
    ""

# game/script morocco leaveship.rpy:320
translate Chinese day14_leave_ending_julian_3904196d:

    # "He better not have chickened out."
    ""

# game/script morocco leaveship.rpy:326
translate Chinese day14_leave_ending_julian_40642112:

    # j "Yo!{w} Mr. [family_name]!"
    j ""

# game/script morocco leaveship.rpy:328
translate Chinese day14_leave_ending_julian_eeb83adf:

    # "Finally."
    ""

# game/script morocco leaveship.rpy:334
translate Chinese day14_leave_ending_julian_099251a9:

    # "Julian dodges a donkey-drawn cart as he crosses the road, a broad grin plastered across his face as he hops over to join you."
    ""

# game/script morocco leaveship.rpy:336
translate Chinese day14_leave_ending_julian_787fb305:

    # p "What's with the formality?"
    p ""

# game/script morocco leaveship.rpy:341
translate Chinese day14_leave_ending_julian_fb771cef:

    # "His grin breaks into a chuckle as he drops his bag of belongings onto the dusty ground."
    ""

# game/script morocco leaveship.rpy:343
translate Chinese day14_leave_ending_julian_437ae61a:

    # j "Just thought it'd be fun to say."
    j ""

# game/script morocco leaveship.rpy:345
translate Chinese day14_leave_ending_julian_e33eb2bc:

    # j "And you? You've just been here, lazily sunning yourself all day long?"
    j ""

# game/script morocco leaveship.rpy:347
translate Chinese day14_leave_ending_julian_a9d74510:

    # p "Had to wait for you, didn't I?"
    p ""

# game/script morocco leaveship.rpy:349
translate Chinese day14_leave_ending_julian_dc6333fb:

    # j "Well, I had a good reason."
    j ""

# game/script morocco leaveship.rpy:353
translate Chinese day14_leave_ending_julian_a7ac09ce:

    # j "'Sides, the sun isn't even gone. Technically, that still counts as dinner time."
    j ""

# game/script morocco leaveship.rpy:356
translate Chinese day14_leave_ending_julian_8c413a20:

    # "You lean over to try and catch a glimpse through the gate, searching for the sun's position on the horizon."
    ""

# game/script morocco leaveship.rpy:358
translate Chinese day14_leave_ending_julian_091b7330:

    # "No luck, though the fierce orange tint of the clouds suggests it won't be long until sunset."
    ""

# game/script morocco leaveship.rpy:360
translate Chinese day14_leave_ending_julian_a311b5d8:

    # p "It's close enough. So, what's this 'good reason' of yours?"
    p ""

# game/script morocco leaveship.rpy:364
translate Chinese day14_leave_ending_julian_570a9ec5:

    # p "Just couldn't leave without stopping by our passenger's cabin one last time?"
    p ""

# game/script morocco leaveship.rpy:366
translate Chinese day14_leave_ending_julian_b429d9ae:

    # "You look him over with a raised brow, searching for clues."
    ""

# game/script morocco leaveship.rpy:370
translate Chinese day14_leave_ending_julian_e4091e34:

    # "He does look... oddly as if he's gained a bit of weight."
    ""

# game/script morocco leaveship.rpy:374
translate Chinese day14_leave_ending_julian_a714ab5e:

    # j "Close, but no."
    j ""

# game/script morocco leaveship.rpy:376
translate Chinese day14_leave_ending_julian_df83ab9b:

    # j "You see, while you've been lying around here doing nothing, I remembered that I haven't actually been thrown off the ship yet."
    j ""

# game/script morocco leaveship.rpy:378
translate Chinese day14_leave_ending_julian_1b7ba9b8:

    # j "And in my infinite wisdom, I..."
    j ""

# game/script morocco leaveship.rpy:383
translate Chinese day14_leave_ending_julian_3729cc1c:

    # "He begins to fish for something hidden in his clothes."
    ""

# game/script morocco leaveship.rpy:385
translate Chinese day14_leave_ending_julian_156b09cf:

    # p "What did you—"
    p ""

# game/script morocco leaveship.rpy:389
translate Chinese day14_leave_ending_julian_2d044400:

    # j "One moment, it's—"
    j ""

# game/script morocco leaveship.rpy:393
